#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# env.sh.example — per-user environment setup for this project.
#
#   cp env.sh.example env.sh     # make your own copy (env.sh is git-ignored)
#   source env.sh                # run this in EVERY new terminal before python/pip
#
# Use `source`, not `bash env.sh`: `bash` would run it in a throwaway sub-shell and
# your terminal would be left unchanged.
# ------------------------------------------------------------------------------

# --- 1. Where things live (edit these if you installed somewhere else) ---------
# $USER expands to your Sol login, so the defaults match the README layout.
export CAL_ENV="/scratch/$USER/envs/lerobot-libero"   # conda env (README step 1)
export LEROBOT_DIR="/scratch/$USER/lerobot"           # lerobot source checkout (README step 2)

# --- 2. Conda ---------------------------------------------------------------
# On Sol, conda is not on PATH until you load the module.
module load mamba/latest 2>/dev/null

# The env was created with `-p <path>`, so it is activated by path, not by name.
conda activate "$CAL_ENV"

# --- 3. Headless rendering -----------------------------------------------------
# There is no display on a compute node. MuJoCo/robosuite must render off-screen
# through EGL (uses the GPU). Without this you get "GLFW/OpenGL" errors.
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl

# --- 4. Hugging Face cache -----------------------------------------------------
# Model checkpoints (smolvla_libero ~1 GB) and datasets are cached here.
# Default is ~/.cache/huggingface, but Sol home quotas are small — keep it on scratch.
export HF_HOME="/scratch/$USER/hf_cache"

# --- 5. Sanity print ------------------------------------------------------------
echo "env: $CONDA_PREFIX"
echo "lerobot: $(python -c 'import lerobot, os; print(os.path.dirname(lerobot.__file__))' 2>/dev/null || echo 'NOT FOUND — check CAL_ENV / README step 2')"
echo "MUJOCO_GL=$MUJOCO_GL  HF_HOME=$HF_HOME"
